{
  "name": "memoryharbor",
  "version": "0.1.0",
  "description": "Local-first memory packs for agent traces, chats, and tool logs.",
  "type": "module",
  "bin": {
    "memoryharbor": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "fixtures",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "node scripts/package-smoke.js",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agents",
    "local-first",
    "memory",
    "cli",
    "search",
    "citations",
    "privacy"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/memoryharbor.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/memoryharbor/issues"
  },
  "homepage": "https://github.com/rogerchappel/memoryharbor#readme",
  "engines": {
    "node": ">=20"
  }
}
